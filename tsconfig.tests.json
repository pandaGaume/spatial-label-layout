{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@spacexr/spatial-label-layout-core": ["packages/core/src/index.ts"],
      "@spacexr/spatial-label-layout-debug": ["packages/debug/src/index.ts"],
      "@spacexr/spatial-label-layout-babylon/gltf-loader": ["packages/babylon/src/gltf/label-loader.ts"],
      "@spacexr/spatial-label-layout-babylon/gltf-exporter": ["packages/babylon/src/gltf/label-exporter.ts"],
      "@spacexr/spatial-label-layout-babylon": ["packages/babylon/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "benchmarks/**/*.ts", "examples/**/*.ts", "vitest.config.ts"]
}
