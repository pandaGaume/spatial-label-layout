{
  "name": "@spacexr/spatial-label-layout-babylon",
  "version": "0.1.2",
  "description": "Babylon.js adapter for spatial label layout: camera views, renderers that place the application's own 3D label objects and their leaders, render loop hook, and the SPACEXR_label glTF extension.",
  "license": "Apache-2.0",
  "author": "Guillaume Pelletier (SpaceXR)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandaGaume/spatial-label-layout.git",
    "directory": "packages/babylon"
  },
  "homepage": "https://github.com/pandaGaume/spatial-label-layout#readme",
  "bugs": {
    "url": "https://github.com/pandaGaume/spatial-label-layout/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gltf-loader": {
      "types": "./dist/gltf/label-loader.d.ts",
      "import": "./dist/gltf/label-loader.js",
      "default": "./dist/gltf/label-loader.js"
    },
    "./gltf-exporter": {
      "types": "./dist/gltf/label-exporter.d.ts",
      "import": "./dist/gltf/label-exporter.js",
      "default": "./dist/gltf/label-exporter.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@babylonjs/serializers": "^9.0.0",
    "@spacexr/spatial-label-layout-core": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "@babylonjs/loaders": {
      "optional": true
    },
    "@babylonjs/serializers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "9.33.1",
    "@babylonjs/loaders": "9.33.1",
    "@babylonjs/serializers": "9.33.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
