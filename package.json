{
  "name": "spatial-label-layout",
  "private": true,
  "version": "0.1.0",
  "description": "Renderer-agnostic 3D label layout engine: mesh anchors, persistent leaders, camera-projected collision solving, stereo/WebXR validation.",
  "license": "Apache-2.0",
  "author": "Guillaume Pelletier (SpaceXR)",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/debug",
    "packages/babylon"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "bench:budget": "tsc -b && tsx benchmarks/budget.ts",
    "example:basic": "tsc -b && tsx examples/basic/main.ts",
    "example:dense": "tsc -b && tsx examples/dense-labels/main.ts",
    "example:terrain": "tsc -b && tsx examples/terrain/main.ts",
    "example:webxr": "tsc -b && tsx examples/webxr/main.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@babylonjs/core": "9.33.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
